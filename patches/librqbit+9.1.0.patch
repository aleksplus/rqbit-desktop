+    /// Force a full checksum validation of the torrent's existing files.
+    ///
+    /// Forgetting removes the fast-resume bitfield, so re-adding the stored
+    /// torrent bytes runs the same initial check used for pre-existing files.
+    pub async fn api_torrent_action_check_files(
+        &self,
+        idx: TorrentIdOrHash,
+    ) -> Result<EmptyJsonResponse> {
+        let handle = self.mgr_handle(idx)?;
+        if handle.with_state(|state| {
+            matches!(state, ManagedTorrentState::Initializing(_))
+        }) {
+            return Err(ApiError::from((
+                StatusCode::BAD_REQUEST,
+                "torrent is already checking files",
+            )));
+        }
+
+        let metadata = handle
+            .metadata
+            .load_full()
+            .context("torrent metadata is not resolved")
+            .with_status(StatusCode::BAD_REQUEST)?;
+        let id = handle.id();
+        let output_folder = handle
+            .output_folder()
+            .to_str()
+            .context("torrent output folder is not valid UTF-8")
+            .with_status(StatusCode::BAD_REQUEST)?
+            .to_owned();
+        let shared = handle.shared();
+        let opts = AddTorrentOptions {
+            paused: handle.is_paused(),
+            only_files: handle.only_files(),
+            overwrite: true,
+            output_folder: Some(output_folder),
+            force_tracker_interval: shared.options.force_tracker_interval,
+            ratelimits: shared.options.ratelimits,
+            initial_peers: Some(shared.options.initial_peers.clone()),
+            peer_limit: shared.options.peer_limit,
+            preferred_id: Some(id),
+            trackers: Some(shared.trackers.iter().map(|t| t.to_string()).collect()),
+            ..Default::default()
+        };
+
+        self.api_torrent_action_forget(id.into()).await?;
+        self.api_add_torrent(
+            AddTorrent::TorrentFileBytes(metadata.torrent_bytes.clone()),
+            Some(opts),
+        )
+        .await?;
+        Ok(Default::default())
+    }
